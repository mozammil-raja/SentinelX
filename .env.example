# SentinelX Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local or production environment.

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sentinelx
DB_USER=sentinel_user
DB_PASSWORD=sentinel_password

# Cache & Velocity Engine (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080
